{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RadByte: Build & Update dist/",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/package.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "RadByte: Verify & Update dist/",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/verify.ps1"
      ],
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ]
}
