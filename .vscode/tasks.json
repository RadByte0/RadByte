{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RadByte: Build workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--workspace", "--release", "--locked"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "RadByte: Test workspace",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace", "--locked"],
      "group": "test",
      "problemMatcher": "$rustc"
    }
  ]
}
